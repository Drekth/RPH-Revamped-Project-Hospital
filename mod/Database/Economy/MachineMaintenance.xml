<Database>
    <!-- RPH Economy: machine wear, random breakdowns and paid repairs.
         Every priced exam adds wear to the machine it used (0-100). A machine with a WEAR line below is
         maintained: past 50 the game's janitors come to service it, at 100 it is broken (no exam can use it
         until a janitor repairs it). Each use can also break it at random: the chance grows from BASE to MAX
         with the wear. The hospital pays when a janitor finishes: REPAIR if serviced before breaking,
         BREAKDOWN_REPAIR if it had broken. Machines without lines are untouched.
         Starting values to be balanced with the statistics window. -->

    <!-- 1 = on, 0 = off (vanilla behavior: no wear, no breakdown). -->
    <GameDBTweakableInt ID="RPH_ECONOMY_MACHINE_MAINTENANCE_ENABLED"> <Value>1</Value> </GameDBTweakableInt>

    <!-- Chance that one use breaks the machine: BASE when new, MAX when fully worn (0.001 = 0.1 %). -->
    <GameDBTweakableFloat ID="RPH_ECONOMY_MACHINE_BREAKDOWN_BASE_CHANCE"> <Value>0.001</Value> </GameDBTweakableFloat>
    <GameDBTweakableFloat ID="RPH_ECONOMY_MACHINE_BREAKDOWN_MAX_CHANCE"> <Value>0.04</Value> </GameDBTweakableFloat>

    <!-- CT scanner -->
    <GameDBTweakableFloat ID="RPH_ECONOMY_MACHINE_WEAR_OBJECT_CT_1"> <Value>0.5</Value> </GameDBTweakableFloat>
    <GameDBTweakableInt ID="RPH_ECONOMY_MACHINE_REPAIR_OBJECT_CT_1"> <Value>500</Value> </GameDBTweakableInt>
    <GameDBTweakableInt ID="RPH_ECONOMY_MACHINE_BREAKDOWN_REPAIR_OBJECT_CT_1"> <Value>1500</Value> </GameDBTweakableInt>

