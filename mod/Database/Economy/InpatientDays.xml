<Database>
    <!-- RPH Economy: inpatient days. Every night at midnight, each patient who has a hospital bed counts one day:
         the insurance pays the department PAY, and the care (drugs, consumables, treatments) costs the hospital COST.
         Both depend on the patient's hospitalization type at midnight. Patients still waiting for a bed count nothing.
         The game's diagnosis payment at discharge is unchanged. Hospitalization types without lines are free.
         Starting values to be balanced with the statistics window. Other mods can override any value by redefining its ID. -->

    <!-- 1 = on, 0 = off (vanilla behavior: paid once, at discharge). -->
    <GameDBTweakableInt ID="RPH_ECONOMY_INPATIENT_DAYS_ENABLED"> <Value>1</Value> </GameDBTweakableInt>

    <!-- Regular ward -->
    <GameDBTweakableInt ID="RPH_ECONOMY_INPATIENT_DAY_PAY_TRT_HOSPITALIZATION_NORMAL"> <Value>250</Value> </GameDBTweakableInt>
    <GameDBTweakableInt ID="RPH_ECONOMY_INPATIENT_DAY_COST_TRT_HOSPITALIZATION_NORMAL"> <Value>150</Value> </GameDBTweakableInt>

    <!-- High dependency unit -->
    <GameDBTweakableInt ID="RPH_ECONOMY_INPATIENT_DAY_PAY_TRT_HOSPITALIZATION_HIGH_PRIORITY"> <Value>450</Value> </GameDBTweakableInt>
    <GameDBTweakableInt ID="RPH_ECONOMY_INPATIENT_DAY_COST_TRT_HOSPITALIZATION_HIGH_PRIORITY"> <Value>300</Value> </GameDBTweakableInt>

    <!-- Intensive care unit -->
    <GameDBTweakableInt ID="RPH_ECONOMY_INPATIENT_DAY_PAY_TRT_HOSPITALIZATION_ICU"> <Value>900</Value> </GameDBTweakableInt>
    <GameDBTweakableInt ID="RPH_ECONOMY_INPATIENT_DAY_COST_TRT_HOSPITALIZATION_ICU"> <Value>650</Value> </GameDBTweakableInt>

    <!-- Emergency observation -->
    <GameDBTweakableInt ID="RPH_ECONOMY_INPATIENT_DAY_PAY_TRT_HOSPITALIZATION_OBSERVATION"> <Value>150</Value> </GameDBTweakableInt>
    <GameDBTweakableInt ID="RPH_ECONOMY_INPATIENT_DAY_COST_TRT_HOSPITALIZATION_OBSERVATION"> <Value>100</Value> </GameDBTweakableInt>

    <!-- Trauma center (DLC Traumatology) -->
    <GameDBTweakableInt ID="RPH_ECONOMY_INPATIENT_DAY_PAY_TRT_HOSPITALIZATION_TRAUMA"> <Value>300</Value> </GameDBTweakableInt>
    <GameDBTweakableInt ID="RPH_ECONOMY_INPATIENT_DAY_COST_TRT_HOSPITALIZATION_TRAUMA"> <Value>250</Value> </GameDBTweakableInt>
</Database>
